---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Summary from "../components/Summary.astro";
import ProjectList from "../components/Projects/ProjectList.astro";
import SkillList from "../components/Skills/SkillList.astro";
import WorkList from "../components/Work/WorkList.astro";
import EducationList from "../components/Education/EducationList.astro";
---

<Layout title="Resume | Jonathan Cheng">
  <div
    class="mb h-full w-full items-center justify-center letter:mb-0"
  >
    <div class="">
      <Section title="Summary">
        <Summary />
      </Section>
    </div>
    <div
      class="h-full"
    >
      <Section title="Experience">
        <WorkList />
      </Section>
    </div>
    <div
      class="h-full"
    >
      <Section title="Skills">
        <SkillList />
      </Section>
    </div>
    <div class="h-full">
      <Section title="Projects">
        <ProjectList />
      </Section>
    </div>
    <div class="h-full">
      <Section title="Education">
        <EducationList />
      </Section>
    </div>
  </div>
</Layout>
